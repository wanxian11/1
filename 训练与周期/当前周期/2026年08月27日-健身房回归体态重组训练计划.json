  "progression_rules": [
    {
      "scope": "W1—W2 健身房适应与负荷校准",
      "when": "每个动作先完成 2—3 组并确认杠铃/器械动作稳定",
      "action": "W1 以校准为主，杠铃动作用停训前 60—70% 或空杆起步，不强行加量；W2 稳定后逐步加到计划组数"
    },
    {
      "scope": "W3—W4 标准体态重组训练量",
      "when": "W2 复盘确认动作稳定、无异常酸痛",
      "action": "按计划全量执行，复合动作保持在 6—10 次区间，孤立动作 10—15 次区间"
    },
    {
      "scope": "双进阶（double progression）",
      "when": "某一动作全部组达到次数上限且末组不超过 RPE 8（约留 2 次余力）",
      "action": "上肢/孤立动作 +2.5kg（或最小可加载档位）、下肢复合 +5kg，回到次数下限"
    },
    {
      "scope": "变形或余力不足",
      "when": "任一动作无法标准完成、余力不足或疼痛",
      "action": "保持重量或下调 5%—10%，优先保证动作质量"
    },
    {
      "scope": "有氧与腹部加强",
      "when": "每次力量训练后 15—20 分钟快走/轻有氧；补强日腹部后可选 20—30 分钟",
      "action": "以能说话不喘的强度推进；腹部动作宁轻勿假，不借力"
    }
  ],
